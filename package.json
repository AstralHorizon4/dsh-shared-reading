{
  "name": "dsh-shared-reading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read books inside DSH and talk a highlighted passage over with the agent.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
